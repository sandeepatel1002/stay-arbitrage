# StayArbitrage — copy this file to `.env` and paste your real keys.
# Never commit `.env` to git.

# Google AI Studio (Gemini API) — powers all 3 AI engines (Intent Parser,
# Matchmaker, Perk Value Equivalence). Get one at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_studio_key_here

# Primary Gemini model + fallback chain (verified live on the owner's key):
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.6-flash,gemini-3.8-flash

# SerpApi — live Google Hotels data (search + property_token details)
# Get one at: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=your_serpapi_key_here

# Fail-fast policy (v0.3.0): there is NO offline cache. If an API is missing
# or unreachable, endpoints return HTTP 503 with a clear message — the app
# shows exactly what failed instead of substitute data.
